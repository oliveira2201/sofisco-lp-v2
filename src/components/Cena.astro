---
// Ilustracao do pe de cada card. SVG inline, sem imagem e sem JS.
const { tipo } = Astro.props;
---
{tipo === 'transicao' && (
<svg class="cena" viewBox="0 0 360 190" role="img" aria-label="Transição contábil organizada">
  <defs><pattern id="gT" width="18" height="18" patternUnits="userSpaceOnUse">
    <path d="M18 0H0v18" fill="none" stroke="#1b3252" stroke-width=".8"/></pattern></defs>
  <rect width="360" height="190" rx="12" fill="#0c1e39"/><rect width="360" height="190" rx="12" fill="url(#gT)"/>
  <rect x="34" y="46" width="112" height="86" rx="10" fill="none" stroke="#3d5b86" stroke-width="1.4"/>
  <text x="48" y="118" fill="#8ea6c8" font-family="Manrope,sans-serif" font-size="11" font-weight="700" letter-spacing="1.2">ATUAL</text>
  <rect x="214" y="46" width="112" height="86" rx="10" fill="#5f86e9"/>
  <text x="228" y="118" fill="#fff" font-family="Manrope,sans-serif" font-size="11" font-weight="700" letter-spacing="1.2">SOFISCO</text>
  <path d="m296 62 5 5 9-9" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="180" cy="89" r="21" fill="#fff"/>
  <g transform="translate(169,78) scale(.92)" stroke="#0a1830" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M2 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L20 8"/><path d="M20 3v5h-5"/>
    <path d="M20 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L2 16"/><path d="M7 16H2v5"/>
  </g>
  <text x="34" y="164" fill="#6d86ab" font-family="Manrope,sans-serif" font-size="9" font-weight="700" letter-spacing="1.6">TRANSIÇÃO CONTÁBIL ORGANIZADA</text>
</svg>)}

{tipo === 'rotina' && (
<svg class="cena" viewBox="0 0 360 190" role="img" aria-label="Fiscal, contábil e departamento pessoal no mesmo lugar">
  <defs><pattern id="gR" width="18" height="18" patternUnits="userSpaceOnUse">
    <path d="M18 0H0v18" fill="none" stroke="#d6e2f8" stroke-width=".8"/></pattern></defs>
  <rect width="360" height="190" rx="12" fill="#eef3fd"/><rect width="360" height="190" rx="12" fill="url(#gR)"/>
  <rect x="40" y="44" width="96" height="112" rx="9" fill="#5f86e9" transform="rotate(-7 88 100)"/>
  <g transform="rotate(3 176 100)">
    <rect x="112" y="34" width="128" height="124" rx="9" fill="#fff" stroke="#dbe5f8"/>
    <text x="130" y="58" fill="#0a1830" font-family="Manrope,sans-serif" font-size="9.5" font-weight="800" letter-spacing="1.3">ROTINA MENSAL</text>
    <rect x="130" y="70" width="92" height="5" rx="2.5" fill="#dbe5f8"/>
    <rect x="130" y="84" width="74" height="5" rx="2.5" fill="#dbe5f8"/>
    <rect x="130" y="98" width="86" height="5" rx="2.5" fill="#dbe5f8"/>
    <rect x="130" y="112" width="58" height="5" rx="2.5" fill="#dbe5f8"/>
  </g>
  <circle cx="272" cy="122" r="25" fill="#fff" stroke="#5f86e9" stroke-width="1.6"/>
  <path d="m262 122 7 7 13-14" stroke="#5f86e9" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="40" y="176" fill="#7d8ea6" font-family="Manrope,sans-serif" font-size="9" font-weight="700" letter-spacing="1.6">FISCAL · CONTÁBIL · DP</text>
</svg>)}

{tipo === 'abertura' && (
<svg class="cena" viewBox="0 0 360 190" role="img" aria-label="Do CNAE ao CNPJ ativo">
  <defs><pattern id="gA" width="18" height="18" patternUnits="userSpaceOnUse">
    <path d="M18 0H0v18" fill="none" stroke="#1b3252" stroke-width=".8"/></pattern></defs>
  <rect width="360" height="190" rx="12" fill="#0c1e39"/><rect width="360" height="190" rx="12" fill="url(#gA)"/>
  <rect x="40" y="112" width="46" height="30" rx="5" fill="#1c3557"/>
  <rect x="102" y="92" width="46" height="50" rx="5" fill="#1c3557"/>
  <rect x="164" y="72" width="46" height="70" rx="5" fill="#24406a"/>
  <rect x="226" y="52" width="46" height="90" rx="5" fill="#2c4c7e"/>
  <path d="M52 128 118 106l64-22 68-24" stroke="#5f86e9" stroke-width="2.2" fill="none" stroke-linecap="round"/>
  <path d="m244 52 16 8-16 8" stroke="#5f86e9" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="52" cy="128" r="4.5" fill="#5f86e9"/><circle cx="118" cy="106" r="4.5" fill="#5f86e9"/>
  <circle cx="182" cy="84" r="4.5" fill="#5f86e9"/>
  <rect x="26" y="34" width="62" height="24" rx="12" fill="#16294a"/>
  <text x="43" y="50" fill="#9db4d6" font-family="Manrope,sans-serif" font-size="10" font-weight="800" letter-spacing="1">CNAE</text>
  <rect x="252" y="18" width="86" height="26" rx="13" fill="#5f86e9"/>
  <path d="m266 31 4 4 7-7" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="283" y="35" fill="#fff" font-family="Manrope,sans-serif" font-size="10" font-weight="800" letter-spacing="1">CNPJ ATIVO</text>
  <text x="40" y="170" fill="#6d86ab" font-family="Manrope,sans-serif" font-size="9" font-weight="700" letter-spacing="1.6">ENQUADRAMENTO DEFINIDO ANTES DE ABRIR</text>
</svg>)}

<style>
  .cena{width:100%;height:auto;display:block;border-radius:12px;margin-top:26px}
</style>
