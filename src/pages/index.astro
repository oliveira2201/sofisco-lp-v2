---
import '../styles/global.css';
const ZAP = (t) => `https://wa.me/551136525424?text=${encodeURIComponent(t)}`;
const cards = [
  { n:'01', t:'Quero trocar de contador',
    d:'Você já tem empresa e já tem contador, mas fala com um robô, descobre imposto pago a mais depois do fato e não tem a quem perguntar. A migração é nossa: pedimos a documentação ao seu contador atual.',
    cta:'Planejar minha troca', msg:'Olá! Tenho empresa e quero trocar de contador. Podem me explicar como funciona a migração?' },
  { n:'02', t:'Preciso de um contador para minha empresa',
    d:'Escritório contábil com contador para empresa de comércio, serviços ou pequena indústria. Escrita fiscal, contabilidade e folha no mesmo lugar, com consultoria tributária inclusa e um contador que atende pelo nome.',
    cta:'Falar sobre minha empresa', msg:'Olá! Preciso de um contador para a minha empresa. Podem me passar mais informações?' },
  { n:'03', t:'Vou abrir e quero acompanhamento',
    d:'Abrir empresa é a parte fácil. O que decide o custo do primeiro ano é o CNAE certo e o enquadramento certo, e é isso que organizamos na abertura de empresa, antes de você assinar qualquer coisa.',
    cta:'Planejar minha abertura', msg:'Olá! Vou abrir uma empresa e quero acompanhamento contábil. Podem me ajudar?' },
];
const riscos = [
  { n:'01', t:'Você sabe se o seu CNAE reflete exatamente o que a empresa vende, ou está pagando imposto a mais desde a abertura?' },
  { n:'02', t:'Seu contador avisa antes do vencimento, ou você descobre o problema quando a multa chega?' },
  { n:'03', t:'Quanto uma revisão tributária feita tarde representa em imposto, juros e multa retroativa?' },
];
const passos = [
  { n:'1º Passo', t:'Entendemos seu momento', d:'Você conta como está hoje: o que a empresa faz, o regime atual e o que não vai bem com a contabilidade. Sem formulário interminável.' },
  { n:'2º Passo', t:'Fazemos o diagnóstico', d:'Analisamos atividade, faturamento, CNAEs e o enquadramento tributário mais coerente com a sua realidade. Sem custo.' },
  { n:'3º Passo', t:'Cuidamos da migração', d:'Pedimos a documentação ao seu contador atual e conduzimos a transferência. Você não perde documento nem atrasa obrigação.' },
  { n:'4º Passo', t:'Assumimos a rotina', d:'Escrita fiscal, contabilidade e folha integradas, com consultoria tributária inclusa e gente atendendo pelo nome.' },
];
const depos = [
  { i:'E', n:'Edilson Bandeira', t:'Sou cliente desde 2023. O atendimento prestado pelos proprietários (Marcelo e Célia), bem como todos os colaboradores, é fantástico, sempre muito educados, cordiais e principalmente profissionais, atendendo todas as necessidades e demandas dos empresários. Estou muito satisfeito com a prestação de serviço. Recomendo a todos.' },
  { i:'F', n:'Flavio B. Pinheiro', t:'Somos clientes da Sofisco há mais de 15 anos, com duas empresas, e podemos afirmar com convicção: a confiança que depositamos nos serviços contratados só cresceu ao longo desse tempo. A qualidade técnica, a atenção aos detalhes e o comprometimento da equipe fazem toda a diferença.' },
  { i:'K', n:'Katia Murro', t:'Sofisco é a minha contabilidade há mais de 20 anos e só tenho elogios a fazer. Rapidez, eficiência e tratamento humanizado.' },
  { i:'N', n:'Norma Primo', t:'Sofisco é uma empresa séria, de extrema confiabilidade, altamente gabaritada e pronta para atender as mais diversas necessidades dos clientes. Profissionais competentes, prestativos e cordiais.' },
];
const faq = [
  { p:'Quanto custa a contabilidade da Sofisco?', r:'A partir de R$ 400 por mês para empresa no Simples Nacional, com escrita fiscal, contabilidade e folha inclusas, mais a consultoria tributária. O valor final depende do porte, do volume de notas e do número de funcionários.' },
  { p:'Dá trabalho trocar de contador?', r:'O trabalho é nosso. Pedimos a documentação ao seu contador atual, conferimos o que está pendente e conduzimos a transferência. Você não precisa intermediar nem perder obrigação no caminho.' },
  { p:'Vocês atendem empresa de qual porte?', r:'Comércio, serviços e pequenas indústrias. Fazemos contabilidade para pequenas empresas no Simples Nacional e contabilidade para Lucro Presumido, incluindo contador para ME. É o porte em que a nossa estrutura entrega atenção de verdade.' },
  { p:'O atendimento é presencial ou online?', r:'Os dois. Fazemos contabilidade presencial no escritório físico de Osasco, na Vila Osasco, para quem prefere resolver olho no olho e quer um contador perto de você. O dia a dia corre por WhatsApp e pelo portal, com pessoa respondendo.' },
  { p:'Vocês atendem fora de Osasco?', r:'Sim. Atendemos Osasco, Barueri, Alphaville, Carapicuíba, Cotia, Santana de Parnaíba, Itapevi, Taboão da Serra e a zona oeste de São Paulo.' },
];
---
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Escritório de Contabilidade em Osasco | Sofisco, desde 1996</title>
<meta name="description" content="Escritório de contabilidade em Osasco desde 1996. Atendemos empresas de Osasco, Barueri, Alphaville e região. Contabilidade, escrita fiscal, folha e consultoria tributária a partir de R$ 400/mês.">
<meta name="theme-color" content="#0a1830">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Source+Sans+3:wght@400;600&display=swap">
</head>
<body>

<header style="position:sticky;top:0;z-index:50;background:rgba(10,24,48,.94);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,.08)">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;height:76px">
    <a href="/" style="display:flex;align-items:center;gap:12px">
      <img src="/images/simbolo.webp" alt="Sofisco Contabilidade" width="40" height="40" style="width:40px;height:auto">
      <span style="font-family:Manrope,sans-serif;font-weight:800;color:#fff;letter-spacing:.06em;line-height:1.1">SOFISCO<br><span style="font-size:.62rem;font-weight:500;letter-spacing:.2em;color:#93a2ba">CONTABILIDADE</span></span>
    </a>
    <a class="btn btn-azul" href={ZAP('Olá! Vim pelo site e quero falar com um contador da Sofisco.')} style="padding:12px 22px;font-size:.92rem">Falar com um contador</a>
  </div>
</header>

<!-- 1. HERO -->
<section class="hero-sec" style="background:var(--marinho);color:#fff;padding:72px 0 64px;position:relative;overflow:hidden">
  <div class="wrap grid-2">
    <div>
      <span class="olho" style="color:#8fb0ff">Escritório físico em Osasco · desde 1996</span>
      <h1 style="color:#fff">Escritório de contabilidade em <span style="color:var(--azul)">Osasco</span>, atendendo empresas desde 1996.</h1>
      <p class="lead claro">Contabilidade, escrita fiscal e folha com consultoria tributária inclusa. Não é contabilidade de prateleira que só emite guia: é contador que atende pelo nome.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
        <a class="btn btn-azul" href="#diagnostico">Quero meu diagnóstico gratuito</a>
        <a class="btn btn-linha claro" href={ZAP('Olá! Vim pelo site e quero falar com um contador da Sofisco.')}>Falar no WhatsApp</a>
      </div>
    </div>
    <div><img src="/images/hero.webp" alt="Equipe da Sofisco Contabilidade" width="475" height="595" style="border-radius:20px;width:100%;height:auto" fetchpriority="high"></div>
  </div>
</section>

<!-- FAIXA: as duas primeiras perguntas de quem busca -->
<div style="background:var(--azul-claro);border-bottom:1px solid var(--linha);padding:20px 0">
  <div class="wrap" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px" id="faixa">
    <div style="border-left:3px solid var(--verde);padding-left:13px">
      <div class="olho" style="color:#6a7688;margin-bottom:4px">Contabilidade completa</div>
      <div style="font-size:1.15rem;font-weight:800;color:var(--verde);font-family:Manrope,sans-serif">a partir de R$ 400/mês</div>
      <div style="font-size:.9rem;color:var(--tinta-2)">fiscal, contábil e folha, com consultoria</div>
    </div>
    <div style="border-left:3px solid var(--azul);padding-left:13px">
      <div class="olho" style="color:#6a7688;margin-bottom:4px">Escritório físico</div>
      <div style="font-size:.95rem">Av. Dionysia Alves Barreto, 130<br>Vila Osasco, Osasco/SP</div>
    </div>
    <div style="border-left:3px solid var(--azul);padding-left:13px">
      <div class="olho" style="color:#6a7688;margin-bottom:4px">Atendemos</div>
      <div style="font-size:.95rem">Osasco, Barueri, Alphaville,<br>Carapicuíba, Cotia e São Paulo</div>
    </div>
    <div style="border-left:3px solid var(--azul);padding-left:13px">
      <div class="olho" style="color:#6a7688;margin-bottom:4px">Telefone</div>
      <div style="font-size:.95rem"><a href="tel:+551136525424" style="color:var(--azul);font-weight:700">(11) 3652-5424</a><br>Seg a qui 8h-18h, sex 8h-17h</div>
    </div>
  </div>
</div>

<!-- 2. TRES CAMINHOS -->
<section class="creme">
  <div class="wrap">
    <div style="text-align:center;max-width:760px;margin:0 auto">
      <span class="olho">Três situações. Uma decisão bem orientada.</span>
      <h2>Em qual etapa o seu negócio está?</h2>
      <p class="lead" style="margin:18px auto 0">A Sofisco organiza o caminho de acordo com a sua realidade, sem solução genérica e sem deixar dúvida importante para depois.</p>
    </div>
    <div class="grid-3">
      {cards.map(c => (
        <div style="background:#fff;border:1px solid var(--linha);border-radius:18px;padding:32px 28px;display:flex;flex-direction:column">
          <span style="font-family:Manrope,sans-serif;font-weight:800;font-size:.85rem;color:var(--azul);letter-spacing:.1em">{c.n}</span>
          <h3 style="margin:12px 0 14px;font-size:1.45rem;font-weight:750">{c.t}</h3>
          <p style="color:var(--tinta-2);font-size:1rem;flex:1">{c.d}</p>
          <a class="btn btn-linha" href={ZAP(c.msg)} style="margin-top:24px;align-self:flex-start">{c.cta}</a>
        </div>
      ))}
    </div>
    <p style="margin:34px auto 0;max-width:900px;text-align:center;color:var(--tinta-2);font-size:1rem;line-height:1.75">
      Assessoria contábil completa, no mesmo escritório: contabilidade mensal, escrita fiscal,
      folha de pagamento, balanço, imposto de renda e consultoria tributária inclusa.
      Somos uma empresa de contabilidade para comércio, serviços e pequenas indústrias
      de Osasco e da Grande São Paulo.
    </p>
  </div>
</section>

<!-- 3. RISCOS -->
<section class="cinza">
  <div class="wrap grid-2">
    <div>
      <span class="olho">Antes de decidir, pare e confira</span>
      <h2>Um detalhe agora pode virar custo depois.</h2>
      <p class="lead">A burocracia não é o maior problema. O risco está em tocar a empresa sem enxergar a consequência tributária de cada escolha.</p>
      <a class="btn btn-azul" href="#diagnostico" style="margin-top:28px">Quero o diagnóstico</a>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px">
      {riscos.map(r => (
        <div style="background:#fff;border:1px solid var(--linha);border-radius:14px;padding:22px 24px;display:flex;gap:16px">
          <span style="font-family:Manrope,sans-serif;font-weight:800;color:var(--azul);font-size:1.05rem">{r.n}</span>
          <p style="font-size:1rem;color:var(--tinta)">{r.t}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 4. PASSO A PASSO -->
<section class="esc">
  <div class="wrap">
    <div style="max-width:720px">
      <span class="olho claro">Cada etapa, sem complicação</span>
      <h2>Trocar de contador é mais simples do que você pensa.</h2>
      <p class="lead claro">A Sofisco organiza a parte técnica, os documentos e os próximos passos. Veja como:</p>
    </div>
    <div class="grid-4">
      {passos.map(p => (
        <div style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:28px 24px">
          <span style="font-family:Manrope,sans-serif;font-weight:800;font-size:.8rem;color:var(--azul);letter-spacing:.08em">{p.n}</span>
          <h3 style="margin:10px 0 12px;font-size:1.2rem">{p.t}</h3>
          <p style="color:#c6d3e8;font-size:.97rem">{p.d}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:40px;color:#dbe5f8">Sem custo para começar. Solicite uma avaliação inicial do seu cenário.
      <a class="btn btn-azul" href="#diagnostico" style="margin-left:14px">Solicitar diagnóstico</a></p>
  </div>
</section>

<!-- 5. TRADICAO -->
<section class="esc-2">
  <div class="wrap grid-2">
    <div>
      <span class="olho claro">Experiência que reduz incertezas</span>
      <h2>Tradição no mercado. Presença em cada decisão.</h2>
      <p class="lead claro">Fundada em 1996, a Sofisco une expertise sólida, atendimento personalizado e tecnologia integrada para impulsionar indústrias, comércios e prestadores de serviços da região de Osasco.</p>
    </div>
    <div class="nums" style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
      {[['+1.500','Empresas atendidas'],['30+','Anos de experiência'],['Simples Nacional','Indústria, comércio e serviços'],['Compliance','Suporte fiscal especializado']].map(([a,b]) => (
        <div style="background:rgba(255,255,255,.07);border-radius:14px;padding:24px">
          <div style="font-family:Manrope,sans-serif;font-weight:800;font-size:1.6rem;color:var(--azul)">{a}</div>
          <div style="color:#c6d3e8;font-size:.92rem;margin-top:6px">{b}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 6. DEPOIMENTOS -->
<section class="azulc">
  <div class="wrap">
    <div style="text-align:center;max-width:700px;margin:0 auto">
      <span class="olho">Experiências reais</span>
      <h2>Depoimentos de nossos clientes</h2>
      <p class="lead" style="margin:18px auto 0">A confiança construída ao longo dos anos, contada por quem conhece nosso atendimento.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:48px" class="depos">
      {depos.map(d => (
        <div style="background:#fff;border-radius:16px;padding:28px">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
            <span style="width:42px;height:42px;border-radius:50%;background:var(--azul);color:#fff;display:grid;place-items:center;font-family:Manrope,sans-serif;font-weight:800">{d.i}</span>
            <div><div style="font-family:Manrope,sans-serif;font-weight:750">{d.n}</div>
            <div style="color:#f0a500;font-size:.85rem">★★★★★</div></div>
          </div>
          <p style="font-size:.98rem;color:var(--tinta-2)">“{d.t}”</p>
          <div class="olho" style="color:#93a2ba;margin:14px 0 0;font-size:.66rem">Avaliação publicada no Google</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 7. FAQ -->
<section class="creme">
  <div class="wrap" style="max-width:900px">
    <span class="olho">Dúvidas frequentes</span>
    <h2>Dúvidas frequentes</h2>
    <div style="margin-top:36px;border-top:1px solid var(--linha)">
      {faq.map((f,i) => (
        <details style="border-bottom:1px solid var(--linha);padding:20px 0">
          <summary style="font-family:Manrope,sans-serif;font-weight:700;font-size:1.08rem;cursor:pointer;list-style:none;display:flex;gap:14px">
            <span style="color:var(--azul)">{String(i+1).padStart(2,'0')}</span>{f.p}</summary>
          <p style="margin-top:14px;color:var(--tinta-2);padding-left:34px">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 8. DIAGNOSTICO / FORMULARIO -->
<section class="esc" id="diagnostico">
  <div class="wrap grid-2">
    <div>
      <span class="olho claro">Seu próximo passo pode ser simples</span>
      <h2>Diagnóstico tributário sem custo.</h2>
      <p class="lead claro">Conte seu momento e receba uma avaliação inicial do seu cenário antes de decidir qualquer coisa. Se preferir, fale direto no WhatsApp.</p>
      <a class="btn btn-zap" href={ZAP('Olá! Quero o diagnóstico tributário gratuito da Sofisco.')} style="margin-top:26px">Conversar no WhatsApp</a>
    </div>
    <form action="https://orbyhub.com.br/api/lead" method="post"
      style="background:#fff;border-radius:18px;padding:30px;display:grid;gap:14px;color:var(--tinta)">
      <input type="hidden" name="source" value="lp-sofisco">
      <label style="display:grid;gap:6px"><span style="font-size:.82rem;font-weight:600">Seu nome</span>
        <input name="name" required placeholder="Nome completo" style="padding:13px 14px;border:1px solid var(--linha);border-radius:10px;font:inherit;font-size:1rem"></label>
      <label style="display:grid;gap:6px"><span style="font-size:.82rem;font-weight:600">Empresa</span>
        <input name="company" placeholder="Nome da empresa" style="padding:13px 14px;border:1px solid var(--linha);border-radius:10px;font:inherit;font-size:1rem"></label>
      <label style="display:grid;gap:6px"><span style="font-size:.82rem;font-weight:600">WhatsApp</span>
        <input name="phone" type="tel" required placeholder="(11) 99999-9999" style="padding:13px 14px;border:1px solid var(--linha);border-radius:10px;font:inherit;font-size:1rem"></label>
      <label style="display:grid;gap:6px"><span style="font-size:.82rem;font-weight:600">E-mail</span>
        <input name="email" type="email" placeholder="seu@email.com" style="padding:13px 14px;border:1px solid var(--linha);border-radius:10px;font:inherit;font-size:1rem"></label>
      <label style="display:grid;gap:6px"><span style="font-size:.82rem;font-weight:600">Regime tributário atual</span>
        <select name="regime" style="padding:13px 14px;border:1px solid var(--linha);border-radius:10px;font:inherit;font-size:1rem;background:#fff">
          <option value="">Qual sua situação?</option>
          <option>Simples Nacional</option><option>Lucro Presumido</option><option>Lucro Real</option>
          <option>MEI</option><option>Não sei qual meu regime</option><option>Ainda não tenho empresa</option>
        </select></label>
      <button class="btn btn-azul" type="submit" style="justify-content:center;margin-top:4px">Quero meu diagnóstico gratuito</button>
      <p style="font-size:.78rem;color:#8792a5;text-align:center">Retornamos em horário comercial. Seus dados não são compartilhados.</p>
    </form>
  </div>
</section>

<footer style="background:var(--marinho-2);color:#c6d3e8;padding:56px 0 30px;font-size:.94rem">
  <div class="wrap" style="display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px">
    <div>
      <img src="/images/logo.webp" alt="Sofisco Contabilidade" width="150" height="52" style="width:150px;height:auto;margin-bottom:16px">
      <p>Contabilidade consultiva para abrir, organizar e conduzir a próxima fase do seu negócio.</p>
    </div>
    <div><div class="olho claro">Contato</div>
      <p><a href="tel:+551136525424">(11) 3652-5424</a><br>
      <a href="mailto:sofisco@sofisco.com.br">sofisco@sofisco.com.br</a><br>
      Seg a qui: 8h-12h e 13h-18h<br>Sex: 8h-12h e 13h-17h</p></div>
    <div><div class="olho claro">Endereço</div>
      <p>Av. Dionysia Alves Barreto, 130<br>Vila Osasco, Osasco — SP<br>CEP 06086-040</p></div>
  </div>
  <div class="wrap" style="border-top:1px solid rgba(255,255,255,.1);margin-top:36px;padding-top:20px;font-size:.82rem;color:#93a2ba">
    © 2026 Sofisco Contabilidade · Consultoria contábil e tributária desde 1996
  </div>
</footer>

<a href={ZAP('Olá! Vim pelo site da Sofisco.')} aria-label="Falar no WhatsApp"
  style="position:fixed;right:20px;bottom:20px;z-index:60;width:58px;height:58px;border-radius:50%;background:var(--zap);display:grid;place-items:center;box-shadow:0 8px 24px rgba(0,0,0,.25)">
  <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff"><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.96 7.96 0 01-4.106-1.138l-.29-.174-3.016.79.806-2.942-.19-.302A7.963 7.963 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
</a>

<style>
@media(max-width:900px){
  section{padding:56px 0}
  /* hero enxuto: a faixa com preco e endereco tem que caber na 1a tela (medido 390x844) */
  .hero-sec{padding:40px 0 20px!important}
  .hero-sec .lead{font-size:1rem;margin-top:14px}
  .hero-sec img{max-height:140px;object-fit:cover;object-position:top}
  .hero-sec .grid-2{gap:20px!important}
  .nums{grid-template-columns:1fr!important}
  #faixa{grid-template-columns:repeat(2,1fr)!important;gap:14px!important}
