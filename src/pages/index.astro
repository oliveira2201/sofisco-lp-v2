---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Cena from '../components/Cena.astro';
const ZAP = (t) => `https://wa.me/551136525424?text=${encodeURIComponent(t)}`;

const cards = [
  { n:'01', eixo:'TROCA', marca:'T', ico:'troca', cena:'transicao', destaque:false,
    t:'Quero trocar de contador',
    d:'Você já tem empresa e procura um acompanhamento mais próximo, com um contador responsável que explique cada decisão antes dela acontecer.',
    itens:['Diagnóstico da situação atual','Organização da troca de informações','Revisão de obrigações e enquadramento','Transição conduzida pela Sofisco'],
    cta:'Planejar minha troca', msg:'Olá! Tenho empresa e quero trocar de contador. Podem me explicar como funciona a migração?' },
  { n:'02', eixo:'CONTABILIDADE', marca:'C', ico:'doc', cena:'rotina', destaque:true,
    t:'Preciso de um contador para minha empresa',
    d:'Escritório contábil com contador para empresa de comércio, serviços ou pequena indústria, com a rotina inteira no mesmo lugar.',
    itens:['Escrita fiscal e apuração mensal','Contabilidade e balanço','Folha de pagamento e encargos','Consultoria tributária inclusa'],
    cta:'Falar sobre minha empresa', msg:'Olá! Preciso de um contador para a minha empresa. Podem me passar mais informações?' },
  { n:'03', eixo:'ABERTURA', marca:'A', ico:'predio', cena:'abertura', destaque:false,
    t:'Vou abrir e quero acompanhamento',
    d:'Abrir empresa é a parte fácil. O que decide o custo do primeiro ano é o CNAE certo e o enquadramento certo, definidos antes de você assinar.',
    itens:['Análise de viabilidade e atividade','Escolha orientada dos CNAEs','Enquadramento no Simples Nacional','Acompanhamento até o CNPJ ativo'],
    cta:'Planejar minha abertura', msg:'Olá! Vou abrir uma empresa e quero acompanhamento contábil. Podem me ajudar?' },
];

const provas = [
  { ico:'selo',    t:'30+ anos',                  s:'Atuando desde 1996' },
  { ico:'pessoas', t:'Atendimento personalizado',  s:'Contador responsável pela conta' },
  { ico:'raio',    t:'Tecnologia integrada',       s:'Portal e WhatsApp no dia a dia' },
];

const faixa = [
  { ico:'recibo', olho:'Honorários', v:'a partir de R$ 400/mês', s:'conforme porte, volume de notas e funcionários', destaque:true },
  { ico:'pin',    olho:'Escritório físico', v:'Av. Dionysia Alves Barreto, 130', s:'Vila Osasco, Osasco/SP' },
  { ico:'mapa',   olho:'Atendemos', v:'Osasco, Barueri e região', s:'Alphaville, Carapicuíba, Cotia e São Paulo' },
  { ico:'fone',   olho:'Telefone', v:'(11) 3652-5424', s:'Seg a qui 8h-18h, sex 8h-17h', tel:true },
];

const riscos = [
  { ico:'lupa',    t:'Você sabe se o CNAE registrado reflete exatamente o que a sua empresa vende hoje?' },
  { ico:'relogio', t:'Você recebe aviso antes de cada vencimento, ou costuma tomar conhecimento da obrigação depois do prazo?', destaque:true },
  { ico:'calc',    t:'Você sabe o que uma revisão tributária feita fora de prazo representa em imposto, juros e multa?' },
];

const passos = [
  { n:'1º Passo', ico:'fone',   t:'Entendemos seu momento', d:'Você conta como está hoje: o que a empresa faz, o regime atual e o que não vai bem com a contabilidade. Sem formulário interminável.' },
  { n:'2º Passo', ico:'lupa',   t:'Fazemos o diagnóstico',  d:'Analisamos atividade, faturamento, CNAEs e o enquadramento tributário mais coerente com a sua realidade. Sem custo.' },
  { n:'3º Passo', ico:'troca',  t:'Cuidamos da migração',   d:'Solicitamos a documentação ao contador atual e conduzimos a transferência. Você não perde documento nem atrasa obrigação.' },
  { n:'4º Passo', ico:'escudo', t:'Assumimos a rotina',     d:'Escrita fiscal, contabilidade e folha integradas, com consultoria tributária inclusa e um contador responsável pela sua conta.' },
];

const numeros = [
  { v:'+1.500', l:'Empresas atendidas' },
  { v:'30+',    l:'Anos de experiência' },
  { v:'3',      l:'Regimes: Simples, Presumido e Real' },
  { v:'9',      l:'Cidades atendidas na região' },
];

const depos = [
  { i:'E', n:'Edilson Bandeira', a:'cliente desde 2023', t:'O atendimento prestado pelos proprietários (Marcelo e Célia), bem como todos os colaboradores, é fantástico, sempre muito educados, cordiais e principalmente profissionais, atendendo todas as necessidades e demandas dos empresários. Estou muito satisfeito com a prestação de serviço.' },
  { i:'F', n:'Flavio B. Pinheiro', a:'cliente há mais de 15 anos', t:'Somos clientes da Sofisco há mais de 15 anos, com duas empresas, e podemos afirmar com convicção: a confiança que depositamos nos serviços contratados só cresceu ao longo desse tempo. A qualidade técnica, a atenção aos detalhes e o comprometimento da equipe fazem toda a diferença.' },
  { i:'K', n:'Katia Murro', a:'cliente há mais de 20 anos', t:'Sofisco é a minha contabilidade há mais de 20 anos e só tenho elogios a fazer. Rapidez, eficiência e tratamento humanizado.' },
  { i:'N', n:'Norma Primo', a:'cliente', t:'Sofisco é uma empresa séria, de extrema confiabilidade, altamente gabaritada e pronta para atender as mais diversas necessidades dos clientes. Profissionais competentes, prestativos e cordiais.' },
];

const faq = [
  { p:'Quanto custa a contabilidade da Sofisco?', r:'Os honorários começam em R$ 400 por mês para empresa no Simples Nacional, com escrita fiscal, contabilidade e folha inclusas, mais a consultoria tributária. O valor final depende do porte, do volume de notas e do número de funcionários.' },
  { p:'Dá trabalho trocar de contador?', r:'O trabalho é nosso. Solicitamos a documentação ao contador atual, conferimos o que está pendente e conduzimos a transferência. Você não precisa intermediar nem perder obrigação no caminho.' },
  { p:'Vocês atendem empresa de qual porte?', r:'Comércio, serviços e pequenas indústrias. Fazemos contabilidade para pequenas empresas no Simples Nacional e contabilidade para Lucro Presumido, incluindo contador para ME. É o porte em que a nossa estrutura entrega atenção de verdade.' },
  { p:'O atendimento é presencial ou online?', r:'Os dois. Fazemos contabilidade presencial no escritório físico de Osasco, na Vila Osasco, para quem prefere resolver olho no olho e quer um contador perto de você. O dia a dia corre por WhatsApp e pelo portal, com pessoa respondendo.' },
  { p:'Vocês atendem fora de Osasco?', r:'Sim. Atendemos Osasco, Barueri, Alphaville, Carapicuíba, Cotia, Santana de Parnaíba, Itapevi, Taboão da Serra e a zona oeste de São Paulo.' },
];
---
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Escritório de Contabilidade em Osasco | Sofisco, desde 1996</title>
<meta name="description" content="Escritório de contabilidade em Osasco desde 1996. Atendemos empresas de Osasco, Barueri, Alphaville e região. Contabilidade, escrita fiscal, folha e consultoria tributária a partir de R$ 400/mês.">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#0a1830">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Source+Sans+3:wght@400;600&display=swap">
</head>
<body>

<header class="topo">
  <div class="wrap topo-in">
    <a href="/" class="marca">
      <img src="/images/sofisco-logo.webp" alt="Sofisco Contabilidade" width="250" height="238">
      <span>SOFISCO<br><span class="marca-sub">CONTABILIDADE</span></span>
    </a>
    <nav class="menu">
      <a href="#etapas">Para você</a>
      <a href="#passos">Como funciona</a>
      <a href="#tradicao">Por que a Sofisco</a>
      <a href="#duvidas">Dúvidas</a>
    </nav>
    <a class="btn btn-azul btn-sm" href={ZAP('Olá! Vim pelo site e quero falar com um contador da Sofisco.')}>
      <span class="cta-longo">Falar com um contador</span><span class="cta-curto">Falar agora</span> <Icon n="seta" s={16} />
    </a>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <span class="orbe orbe-a" aria-hidden="true"></span>
  <span class="orbe orbe-b" aria-hidden="true"></span>
  <div class="wrap grid-2">
    <div class="sobe">
      <span class="olho tracinho">Escritório físico em Osasco · desde 1996</span>
      <h1>Escritório de contabilidade em <span class="az">Osasco</span>, atendendo empresas desde 1996.</h1>
      <p class="lead claro">Contabilidade, escrita fiscal e folha com consultoria tributária inclusa. Escritório próprio, com contador responsável acompanhando a sua empresa.</p>
      <div class="acoes">
        <a class="btn btn-azul" href="#diagnostico">Quero meu diagnóstico gratuito <Icon n="seta" s={17} /></a>
        <a class="btn btn-linha claro" href={ZAP('Olá! Vim pelo site e quero falar com um contador da Sofisco.')}>Falar no WhatsApp</a>
      </div>
      <ul class="checks">
        <li><Icon n="checkCirc" s={18} c="#8fb0ff" /> Escrita fiscal, contabilidade e folha no mesmo escritório</li>
        <li><Icon n="checkCirc" s={18} c="#8fb0ff" /> Consultoria tributária inclusa, sem cobrança por consulta</li>
        <li><Icon n="checkCirc" s={18} c="#8fb0ff" /> Migração conduzida por nós, do pedido de documentos ao fim</li>
      </ul>
    </div>
    <div class="foto sobe atraso-1">
      <img src="/images/hero.webp" alt="Contador da Sofisco atendendo um cliente no escritório de Osasco" width="475" height="595" fetchpriority="high">
    </div>
  </div>
</section>

<div class="tiras">
<!-- PROVAS -->
<div class="provas">
  <div class="wrap provas-in">
    {provas.map(p => (
      <div class="prova">
        <span class="prova-ico"><Icon n={p.ico} s={22} c="#8fb0ff" /></span>
        <div><strong>{p.t}</strong><span>{p.s}</span></div>
      </div>
    ))}
  </div>
</div>

<!-- FAIXA: as perguntas que vem antes de qualquer outra -->
<div class="faixa-wrap">
  <div class="wrap faixa" id="faixa">
    {faixa.map(f => (
      <div class={'fx' + (f.destaque ? ' fx-on' : '')}>
        <span class="fx-ico"><Icon n={f.ico} s={19} /></span>
        <div>
          <span class="olho fx-olho">{f.olho}</span>
          {f.tel
            ? <a class="fx-v" href="tel:+551136525424">{f.v}</a>
            : <div class="fx-v">{f.v}</div>}
          <div class="fx-s">{f.s}</div>
        </div>
      </div>
    ))}
  </div>
</div>
</div>

<!-- ETAPAS -->
<section id="etapas" class="creme">
  <div class="wrap">
    <div class="cabeca">
      <span class="olho">Três situações. Uma decisão bem orientada.</span>
      <h2>Em qual etapa o seu negócio está?</h2>
      <p class="lead centro">A Sofisco organiza o caminho de acordo com a sua realidade e com o regime em que a empresa está enquadrada.</p>
    </div>
    <div class="grid-3">
      {cards.map((c,i) => (
        <article class={'card sobe atraso-' + i + (c.destaque ? ' card-on' : '')}>
          <span class="card-barra" aria-hidden="true"></span>
          <span class="card-marca" aria-hidden="true">{c.marca}</span>
          <div class="card-topo">{c.n} / {c.eixo}</div>
          <span class={'chip' + (c.destaque ? ' chip-az' : '')}><Icon n={c.ico} s={21} c="#fff" /></span>
          <h3>{c.t}</h3>
          <p class="card-d">{c.d}</p>
          <ul class="lista">
            {c.itens.map(it => <li><Icon n="check" s={16} c="var(--azul)" w={2.4} /> {it}</li>)}
          </ul>
          <a class="link-seta" href={ZAP(c.msg)}>{c.cta} <Icon n="seta" s={16} /></a>
          <Cena tipo={c.cena} />
        </article>
      ))}
    </div>
    <p class="rodape-secao">
      Assessoria contábil completa, no mesmo escritório: contabilidade mensal, escrita fiscal,
      folha de pagamento, balanço, imposto de renda e consultoria tributária inclusa.
      Somos uma empresa de contabilidade para comércio, serviços e pequenas indústrias
      de Osasco e da Grande São Paulo.
    </p>
  </div>
</section>

<!-- RISCOS -->
<section class="cinza">
  <div class="wrap grid-2 col-fina">
    <div>
      <span class="olho">Antes de decidir, pare e confira</span>
      <h2>Um detalhe agora pode virar custo depois.</h2>
      <p class="lead">A burocracia não é o maior problema. O risco está em tocar a empresa sem enxergar a consequência tributária de cada escolha.</p>
      <a class="btn btn-azul mt" href="#diagnostico">Quero o diagnóstico <Icon n="seta" s={17} /></a>
    </div>
    <div class="riscos trilho">
      {riscos.map((r,i) => (
        <div class={'risco sobe atraso-' + i + (r.destaque ? ' risco-on' : '')}>
          <span class="risco-n">{String(i+1).padStart(2,'0')}</span>
          <h3 class="risco-q">{r.t}</h3>
          <span class="risco-ico"><Icon n={r.ico} s={22} /></span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PASSOS -->
<section id="passos" class="esc">
  <div class="wrap">
    <div class="cabeca">
      <span class="olho claro">Cada etapa, sem complicação</span>
      <h2>Trocar de contador é mais simples do que você pensa.</h2>
      <p class="lead claro centro">A Sofisco organiza a parte técnica, os documentos e os próximos passos. Veja como:</p>
    </div>
    <div class="grid-4 passos">
      {passos.map((p,i) => (
        <div class={'passo sobe atraso-' + i}>
          <div class="passo-h"><span class="passo-ico"><Icon n={p.ico} s={18} c="#8fb0ff" /></span><span class="passo-n">{p.n}</span></div>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </div>
      ))}
    </div>
    <div class="cta-linha">
      <span>Sem custo para começar. Solicite uma avaliação inicial do seu cenário.</span>
      <a class="btn btn-azul" href="#diagnostico">Solicitar diagnóstico <Icon n="seta" s={17} /></a>
    </div>
  </div>
</section>

<!-- TRADICAO -->
<section id="tradicao" class="esc-2">
  <div class="wrap grid-2">
    <div>
      <span class="olho claro">Experiência que reduz incertezas</span>
      <h2>Tradição no mercado. Presença em cada decisão.</h2>
      <p class="lead claro">Fundada em 1996, a Sofisco une experiência, atendimento personalizado e tecnologia integrada para atender indústrias, comércios e prestadores de serviços da região de Osasco.</p>
    </div>
    <div class="nums">
      {numeros.map((n,i) => (
        <div class={'num sobe atraso-' + i}><strong>{n.v}</strong><span>{n.l}</span></div>
      ))}
    </div>
  </div>
</section>

<!-- DEPOIMENTOS -->
<section class="azulc">
  <div class="wrap">
    <div class="cabeca">
      <span class="olho">Experiências reais</span>
      <h2>Depoimentos de nossos clientes</h2>
      <p class="lead centro">A confiança construída ao longo dos anos, contada por quem conhece nosso atendimento.</p>
    </div>
    <div class="grid-4 depos">
      {depos.map((d,i) => (
        <figure class={'depo sobe atraso-' + i}>
          <div class="estrelas" aria-label="5 de 5">★★★★★</div>
          <blockquote>{d.t}</blockquote>
          <figcaption>
            <span class="avatar">{d.i}</span>
            <span><strong>{d.n}</strong><span class="depo-a">{d.a}</span></span>
          </figcaption>
          <span class="depo-fonte">Avaliação publicada no Google</span>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="duvidas" class="creme">
  <div class="wrap estreito">
    <div class="cabeca">
      <span class="olho">Dúvidas frequentes</span>
      <h2>Antes de falar com a gente</h2>
    </div>
    <div class="faq">
      {faq.map((f,i) => (
        <details open={i === 0}>
          <summary><span class="faq-n">{String(i+1).padStart(2,'0')}</span>{f.p}<span class="faq-mais" aria-hidden="true"></span></summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- FORM -->
<section class="esc recorta" id="diagnostico">
  <span class="orbe orbe-c" aria-hidden="true"></span>
  <div class="wrap grid-2">
    <div>
      <span class="olho claro">Seu próximo passo pode ser simples</span>
      <h2>Diagnóstico tributário sem custo.</h2>
      <p class="lead claro">Conte seu momento e receba uma avaliação inicial do seu cenário antes de decidir qualquer coisa. Se preferir, fale direto no WhatsApp.</p>
      <ul class="checks mt">
        <li><Icon n="checkCirc" s={18} c="#8fb0ff" /> Retornamos em horário comercial</li>
        <li><Icon n="checkCirc" s={18} c="#8fb0ff" /> Sem compromisso de contratação</li>
        <li><Icon n="checkCirc" s={18} c="#8fb0ff" /> Seus dados não são compartilhados</li>
      </ul>
      <a class="btn btn-zap mt" href={ZAP('Olá! Quero o diagnóstico tributário da Sofisco.')}>
        <Icon n="zap" s={19} c="#fff" /> Conversar no WhatsApp
      </a>
    </div>
    <form class="form" method="post" action="https://orbyhub.com.br/api/lead">
      <input type="hidden" name="origem" value="lp-sofisco">
      <label>Seu nome<input name="nome" required autocomplete="name" placeholder="Como podemos te chamar"></label>
      <label>Empresa<input name="empresa" autocomplete="organization" placeholder="Razão social ou nome fantasia"></label>
      <div class="dupla">
        <label>WhatsApp<input name="telefone" required inputmode="tel" autocomplete="tel" placeholder="(11) 90000-0000"></label>
        <label>E-mail<input name="email" type="email" autocomplete="email" placeholder="voce@empresa.com.br"></label>
      </div>
      <label>Regime tributário atual
        <select name="regime">
          <option value="">Qual sua situação?</option>
          <option>Simples Nacional</option>
          <option>Lucro Presumido</option>
          <option>Lucro Real</option>
          <option>MEI</option>
          <option>Não sei qual meu regime</option>
          <option>Ainda não tenho empresa</option>
        </select>
      </label>
      <button class="btn btn-azul largo" type="submit">Solicitar diagnóstico <Icon n="seta" s={17} /></button>
      <small>Retornamos em horário comercial. Seus dados não são compartilhados.</small>
    </form>
  </div>
</section>

<footer class="pe">
  <div class="wrap pe-in">
    <div>
      <a href="/" class="marca"><img src="/images/sofisco-logo.webp" alt="" width="250" height="238" aria-hidden="true">
        <span>SOFISCO<br><span class="marca-sub">CONTABILIDADE</span></span></a>
      <p class="pe-txt">Contabilidade consultiva para abrir, organizar e conduzir a próxima fase do seu negócio.</p>
    </div>
    <div>
      <h4>Contato</h4>
      <a href="tel:+551136525424">(11) 3652-5424</a>
      <a href="mailto:sofisco@sofisco.com.br">sofisco@sofisco.com.br</a>
      <span>Seg a qui: 8h-12h e 13h-18h<br>Sex: 8h-12h e 13h-17h</span>
    </div>
    <div>
      <h4>Endereço</h4>
      <span>Av. Dionysia Alves Barreto, 130<br>Vila Osasco, Osasco/SP<br>CEP 06086-040</span>
      <span class="pe-crc">CRC-SP 2SP019076/O-4</span>
    </div>
    <div>
      <h4>Navegação</h4>
      <a href="#etapas">Para você</a>
      <a href="#passos">Como funciona</a>
      <a href="#tradicao">Por que a Sofisco</a>
      <a href="#duvidas">Dúvidas</a>
    </div>
  </div>
  <div class="wrap pe-fim">
    <span>© 2026 Sofisco Contabilidade Ltda · CNPJ 01.535.885/0001-96 · Organização contábil registrada no CRC-SP sob o nº 2SP019076/O-4</span>
    <span>Consultoria contábil e tributária desde 1996</span>
  </div>
</footer>

<a class="flutua" href={ZAP('Olá! Vim pelo site da Sofisco.')} aria-label="Falar no WhatsApp">
  <Icon n="zap" s={26} c="#fff" />
</a>

<style is:global>
/* ---------- topo ---------- */
.topo{position:sticky;top:0;z-index:50;background:rgba(10,24,48,.94);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,.08)}
.topo-in{display:flex;align-items:center;justify-content:space-between;gap:24px;height:86px}
.marca{display:flex;align-items:center;gap:12px;font-family:Manrope,sans-serif;font-weight:800;color:#fff;letter-spacing:.06em;line-height:1.1}
.marca img{width:46px;height:auto;border-radius:9px;background:#fff;padding:3px;box-sizing:border-box}
.marca-sub{font-size:.62rem;font-weight:500;letter-spacing:.2em;color:#93a2ba}
.menu{display:flex;gap:30px;font-size:1.365rem;color:#c7d4e8;font-weight:600}
.menu a{transition:.16s}
.menu a:hover{color:#fff}
.btn-sm{padding:13px 24px;font-size:1rem;white-space:nowrap}
.cta-curto{display:none}
@media(max-width:1240px){.menu{display:none}}

/* ---------- hero ---------- */
.hero{background:var(--marinho);color:#fff;padding:76px 0 66px;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(760px 460px at 78% 12%,rgba(95,134,233,.20),transparent 62%),
             radial-gradient(560px 420px at 4% 96%,rgba(95,134,233,.11),transparent 66%)}
.hero .wrap{position:relative;z-index:1}
.orbe{position:absolute;border-radius:50%;border:1px solid rgba(143,176,255,.16);pointer-events:none}
.orbe-a{width:420px;height:420px;left:-190px;bottom:-170px}
.orbe-b{width:640px;height:640px;right:-280px;top:-230px}
.recorta{position:relative;overflow:hidden}
.orbe-c{width:520px;height:520px;right:-210px;bottom:-240px;border-color:rgba(143,176,255,.13)}
.az{color:var(--azul)}
.tracinho{display:flex;align-items:center;gap:12px;color:#8fb0ff}
.tracinho::before{content:"";width:26px;height:2px;background:#8fb0ff;flex:none;border-radius:2px}
.acoes{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.checks{list-style:none;margin-top:26px;display:grid;gap:11px}
.checks li{display:flex;align-items:flex-start;gap:10px;font-size:.97rem;color:#cfdcf2}
.checks li svg{flex:none;margin-top:2px}
.foto img{width:100%;height:auto;border-radius:150px 22px 150px 22px;box-shadow:0 30px 70px rgba(0,0,0,.42)}

/* ---------- provas ---------- */
.provas{background:var(--marinho-2);border-top:1px solid rgba(255,255,255,.07);border-bottom:1px solid rgba(255,255,255,.07)}
.provas-in{display:grid;grid-template-columns:repeat(3,1fr)}
.prova{display:flex;align-items:center;gap:14px;padding:24px 26px;color:#fff}
.prova + .prova{border-left:1px solid rgba(255,255,255,.08)}
.prova-ico{width:42px;height:42px;flex:none;display:grid;place-items:center;border-radius:11px;background:rgba(95,134,233,.16)}
.prova strong{display:block;font-family:Manrope,sans-serif;font-size:1.06rem;font-weight:750}
.prova span{font-size:.85rem;color:#93a2ba}
@media(max-width:900px){
  .provas-in{grid-template-columns:1fr}
  .prova + .prova{border-left:0;border-top:1px solid rgba(255,255,255,.08)}
  .prova{padding:15px 4px}
}

/* ---------- faixa ---------- */
.faixa-wrap{background:var(--azul-claro);border-bottom:1px solid var(--linha)}
.faixa{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:22px 24px}
.fx{display:flex;gap:12px;padding-left:14px;border-left:3px solid var(--azul)}
.fx-on{border-left-color:var(--verde)}
.fx-ico{color:var(--azul);flex:none;margin-top:3px}
.fx-on .fx-ico{color:var(--verde)}
.fx-olho{color:#6a7688;margin-bottom:3px;font-size:.68rem}
.fx-v{font-size:1.02rem;font-weight:800;font-family:Manrope,sans-serif;color:var(--tinta);line-height:1.25}
.fx-on .fx-v{color:var(--verde);font-size:1.14rem}
a.fx-v{color:var(--azul)}
.fx-s{font-size:.85rem;color:var(--tinta-2);line-height:1.4}
@media(max-width:900px){.faixa{grid-template-columns:1fr 1fr;gap:14px;padding:16px 24px}}
@media(max-width:520px){.faixa{grid-template-columns:1fr}}

/* as duas tiras: no celular a faixa com honorarios e endereco vem antes da prova social */
.tiras{display:flex;flex-direction:column}
@media(max-width:900px){
  .tiras .provas{order:2}
  .tiras .faixa-wrap{order:1}
}

/* ---------- cabecalhos ---------- */
.cabeca{text-align:center;max-width:780px;margin:0 auto}
.lead.centro{margin-left:auto;margin-right:auto}
.estreito{max-width:880px}
.mt{margin-top:26px}
.rodape-secao{margin:38px auto 0;max-width:900px;text-align:center;color:var(--tinta-2);font-size:1rem;line-height:1.75}

/* ---------- cards ---------- */
.card{position:relative;background:#fff;border:1px solid var(--linha);border-radius:20px;padding:32px 28px 28px;
  display:flex;flex-direction:column;overflow:hidden;box-shadow:0 2px 4px rgba(16,35,66,.04);transition:.24s}
.card:hover{transform:translateY(-5px);box-shadow:0 22px 46px rgba(16,35,66,.13);border-color:#c3d5f5}
.card-on{background:linear-gradient(178deg,#f4f8ff,#fff 42%)}
.card-barra{position:absolute;top:0;left:28px;width:64px;height:4px;border-radius:0 0 4px 4px;background:var(--azul)}
.card-marca{position:absolute;top:14px;right:24px;font-family:Manrope,sans-serif;font-size:5.4rem;font-weight:800;
  line-height:1;color:#0a1830;opacity:.055;pointer-events:none}
.card-topo{font-size:.7rem;font-weight:800;letter-spacing:.15em;color:#8794aa;text-transform:uppercase}
.chip{width:46px;height:46px;border-radius:13px;background:var(--marinho);display:grid;place-items:center;margin:16px 0 18px}
.chip-az{background:var(--azul)}
.card h3{margin-top:2px}
.card-d{color:var(--tinta-2);font-size:.99rem;margin-top:12px}
.lista{list-style:none;margin-top:20px;display:grid;gap:10px}
.lista li{display:flex;align-items:flex-start;gap:9px;font-size:.95rem;color:var(--tinta)}
.lista li svg{flex:none;margin-top:4px}
.link-seta{display:inline-flex;align-items:center;gap:8px;margin-top:auto;padding-top:22px;
  font-family:Manrope,sans-serif;font-weight:750;color:var(--azul);width:fit-content}
.link-seta svg{transition:transform .18s}
.card:hover .link-seta svg{transform:translateX(4px)}

/* na referencia a coluna de texto e mais ESTREITA que a dos cards (443 x 661) */
.col-fina{grid-template-columns:1fr 1.49fr}
@media(max-width:980px){.col-fina{grid-template-columns:1fr}}

/* ---------- riscos (medido na referencia: raio 4px/18px, padding 27px,
   sombra 0 10px 32px rgba(13,35,64,.05), pergunta em Manrope 650) ---------- */
.riscos{display:grid;gap:16px}
.trilho{position:relative;padding-left:40px}
.trilho::before{content:"";position:absolute;left:7px;top:22px;bottom:22px;width:1px;background:var(--linha)}
.risco{position:relative;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:flex-start;
  background:#fff;border:1px solid var(--linha);border-radius:4px 18px 18px 18px;padding:27px 28px;
  box-shadow:0 10px 32px rgba(13,35,64,.05);transition:.22s}
.risco::before{content:"";position:absolute;left:-40px;top:32px;width:15px;height:15px;border-radius:50%;
  background:#fff;border:2px solid var(--linha);box-sizing:border-box}
.risco::after{content:"";position:absolute;left:-36px;top:36px;width:7px;height:7px;border-radius:50%;background:var(--azul)}
.risco:hover{transform:translateX(5px);border-color:#c3d5f5;box-shadow:0 16px 40px rgba(13,35,64,.1)}
.risco-n{font-family:Manrope,sans-serif;font-size:.72rem;font-weight:800;color:var(--azul);letter-spacing:.06em;padding-top:4px}
.risco-q{font-size:1.03rem;font-weight:650;line-height:1.48;letter-spacing:normal;color:#1b2e46}
.risco-ico{color:#9db0cb;flex:none;padding-top:2px}
.risco-on{background:var(--marinho);border-color:var(--marinho)}
.risco-on .risco-q{color:#fff}
.risco-on .risco-n{color:rgba(255,255,255,.7)}
.risco-on .risco-ico{color:#8fb0ff}
.risco-on::after{background:#8fb0ff}
@media(max-width:900px){
  .trilho{padding-left:0}
  .trilho::before,.risco::before,.risco::after{display:none}
  .risco{padding:22px 20px;gap:12px}
}

/* ---------- passos ---------- */
.passo{border-top:2px solid rgba(143,176,255,.26);padding-top:20px}
.passo-h{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.passo-ico{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:rgba(95,134,233,.16)}
.passo-n{font-size:.74rem;font-weight:800;letter-spacing:.14em;color:#8fb0ff;text-transform:uppercase}
.passo h3{font-size:1.2rem;letter-spacing:-.02em;margin-bottom:10px}
.passo p{font-size:.94rem;color:#b9c8de}
.cta-linha{margin-top:52px;display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:22px 26px}
.cta-linha span{color:#cfdcf2}

/* ---------- numeros ---------- */
.nums{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.num{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:15px;padding:22px 20px;transition:.2s}
.num:hover{background:rgba(95,134,233,.14);border-color:rgba(143,176,255,.34)}
.num strong{display:block;font-family:Manrope,sans-serif;font-size:2.1rem;font-weight:800;color:#fff;line-height:1}
.num span{display:block;margin-top:7px;font-size:.87rem;color:#93a2ba}

/* ---------- depoimentos ---------- */
.depo{background:#fff;border:1px solid var(--linha);border-radius:18px;padding:26px 24px;display:flex;flex-direction:column;
  box-shadow:0 2px 4px rgba(16,35,66,.04);transition:.22s}
.depo:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(16,35,66,.12)}
.estrelas{color:#f2a93b;letter-spacing:.14em;font-size:.95rem}
.depo blockquote{margin:14px 0 20px;font-size:.95rem;color:var(--tinta-2);line-height:1.62;flex:1}
.depo figcaption{display:flex;align-items:center;gap:12px}
.avatar{width:40px;height:40px;flex:none;border-radius:50%;background:var(--azul);color:#fff;display:grid;place-items:center;
  font-family:Manrope,sans-serif;font-weight:800}
.depo figcaption strong{display:block;font-size:.95rem;font-family:Manrope,sans-serif}
.depo-a{font-size:.8rem;color:var(--tinta-2)}
.depo-fonte{margin-top:14px;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:#9aa7bb}

/* ---------- faq ---------- */
.faq{margin-top:42px;display:grid;gap:12px}
.faq details{background:#fff;border:1px solid var(--linha);border-radius:15px;overflow:hidden;transition:.2s}
.faq details[open]{border-color:#c3d5f5;box-shadow:0 10px 26px rgba(16,35,66,.07)}
.faq summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:14px;padding:20px 22px;
  font-family:Manrope,sans-serif;font-weight:750;font-size:1.05rem}
.faq summary::-webkit-details-marker{display:none}
.faq-n{font-size:.78rem;font-weight:800;color:var(--azul);letter-spacing:.1em;flex:none}
.faq-mais{margin-left:auto;flex:none;width:14px;height:14px;position:relative}
.faq-mais::before,.faq-mais::after{content:"";position:absolute;background:var(--azul);border-radius:2px;transition:.2s}
.faq-mais::before{left:0;right:0;top:6px;height:2px}
.faq-mais::after{top:0;bottom:0;left:6px;width:2px}
.faq details[open] .faq-mais::after{transform:scaleY(0)}
.faq details p{padding:0 22px 22px 56px;color:var(--tinta-2);font-size:1rem}

/* ---------- form ---------- */
.form{background:#fff;border-radius:20px;padding:30px;display:grid;gap:15px;box-shadow:0 26px 60px rgba(0,0,0,.3)}
.form label{display:grid;gap:6px;font-size:.83rem;font-weight:700;color:var(--tinta-2);font-family:Manrope,sans-serif}
.form input,.form select{width:100%;padding:13px 14px;border:1.5px solid var(--linha);border-radius:11px;
  font-size:1rem;font-family:inherit;color:var(--tinta);background:#fff;transition:.16s}
.form input:focus,.form select:focus{outline:none;border-color:var(--azul);box-shadow:0 0 0 4px rgba(95,134,233,.15)}
.form input::placeholder{color:#a9b4c5}
.dupla{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.largo{width:100%;justify-content:center;margin-top:4px}
.form small{color:var(--tinta-2);font-size:.8rem;text-align:center}
@media(max-width:520px){.dupla{grid-template-columns:1fr}.form{padding:24px 20px}}

/* ---------- rodape ---------- */
.pe{background:var(--marinho);color:#c7d4e8;padding:64px 0 0}
.pe-in{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:38px;padding-bottom:44px}
.pe h4{color:#fff;font-family:Manrope,sans-serif;font-size:.98rem;margin-bottom:14px}
.pe a,.pe span{display:block;font-size:.92rem;margin-bottom:8px;transition:.16s}
.pe a:hover{color:#fff}
.pe-crc{margin-top:12px;font-weight:700;color:#8fb0ff;letter-spacing:.02em}
.pe-txt{margin-top:16px;font-size:.92rem;max-width:34ch}
.pe-fim{border-top:1px solid rgba(255,255,255,.09);padding:20px 24px;display:flex;justify-content:space-between;
  gap:14px;flex-wrap:wrap;font-size:.83rem;color:#8494ad}
.pe-fim span{margin:0}
@media(max-width:900px){.pe-in{grid-template-columns:1fr 1fr;gap:28px}}
@media(max-width:520px){.pe-in{grid-template-columns:1fr}}

/* ---------- flutuante ---------- */
.flutua{position:fixed;right:20px;bottom:20px;z-index:60;width:58px;height:58px;border-radius:50%;
  background:var(--zap);display:grid;place-items:center;box-shadow:0 10px 26px rgba(37,211,102,.42);transition:.2s}
.flutua:hover{transform:scale(1.07)}

/* ---------- animacao de entrada (CSS puro, sem JS) ---------- */
@keyframes sobe{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
.sobe{animation:sobe .62s cubic-bezier(.22,.68,.36,1) both}
.atraso-0{animation-delay:.02s}
.atraso-1{animation-delay:.1s}
.atraso-2{animation-delay:.18s}
.atraso-3{animation-delay:.26s}
/* Fora do hero a entrada e por ROLAGEM, e ai a opacidade NUNCA entra na conta:
   animacao presa no estado inicial deixaria o card invisivel, e conteudo que
   some e pior que conteudo sem animacao. So o deslocamento e animado. */
@keyframes desliza{from{transform:translateY(22px)}to{transform:none}}
@supports (animation-timeline: view()){
  section .sobe{animation:desliza .6s cubic-bezier(.22,.68,.36,1) both;
    animation-timeline:view();animation-range:entry 0% cover 24%;animation-delay:0s;opacity:1}
  .hero .sobe{animation:sobe .62s cubic-bezier(.22,.68,.36,1) both;animation-timeline:auto}
}
@media(prefers-reduced-motion:reduce){.sobe{animation:none!important;opacity:1!important;transform:none!important}}

/* ---------- celular ---------- */
@media(max-width:900px){
  section{padding:58px 0}
  /* o botao do topo nao pode quebrar linha: em 390px ele empurrava o logo */
  .topo-in{height:64px;gap:10px}
  .cta-longo{display:none}
  .cta-curto{display:inline}
  .btn-sm{padding:10px 15px;font-size:.85rem;white-space:nowrap}
  .marca{font-size:.95rem}
  .marca img{width:38px}
  .hero{padding:34px 0 12px}
  .hero .lead{font-size:1rem;margin-top:14px}
  .hero .grid-2{gap:22px}
  /* a faixa com honorarios e endereco precisa caber na 1a tela: a foto encolhe e os bullets saem */
  .foto img{max-height:104px;object-fit:cover;object-position:50% 44%;border-radius:60px 16px 60px 16px}
  .hero .checks{display:none}
  .card{padding:28px 22px 24px}
  .card-marca{font-size:4.2rem}
  .cta-linha{flex-direction:column;align-items:flex-start}
  .faq summary{font-size:.99rem;padding:17px 18px}
  .faq details p{padding:0 18px 18px 18px}
}
</style>
</body>
</html>
